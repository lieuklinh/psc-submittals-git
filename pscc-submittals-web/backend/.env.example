# Postgres connection — local dev default matches the PostgreSQL 17 install
# done via `winget install PostgreSQL.PostgreSQL.17`. Adjust user/password if
# you changed them during setup, and match the port if you kept 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pscc_submittals

# The existing extraction FastAPI backend (Alekhya's repo, psc-submittals-git).
# Run it separately: uvicorn app:app --port 8000
EXTRACTION_BACKEND_URL=http://localhost:8000

# Optional: the Q&A agent service (QnA_Agent/agent_api.py), if running.
AGENT_URL=http://localhost:8100

OPENAI_API_KEY=

# Comma-separated emails auto-added as admin on every new project (bootstrap
# team leads) — same convention as TEAM_LEAD_EMAILS in the Streamlit app.
TEAM_LEAD_EMAILS=charles@pscc.com

# Comma-separated list of origins allowed to call this API (the Vite dev
# server, and later your deployed Azure Static Web Apps origin).
CORS_ORIGINS=http://localhost:5173
